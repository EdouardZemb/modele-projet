{#- Gabarit Copier. `${ {{- prefixe }}X}` : l'espace et le tiret évitent `${{{`, que Jinja lit mal. -#}
# Le contenu de l'instance, monté en lecture seule sur /contenu (M-0006, § 5) : le dossier contenu/
# de l'instantané du commit de données, jamais le clone des données. `dc` (lib.sh) n'ajoute ce
# fichier que quand compose.env porte {{ prefixe }}CONTENU, en staging comme en prod. Géré par le
# modèle.
services:
  app:
    volumes:
      - "${ {{- prefixe }}CONTENU:?}:/contenu:ro"
