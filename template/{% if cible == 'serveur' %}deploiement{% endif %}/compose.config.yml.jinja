{#- Gabarit Copier. `${ {{- prefixe }}X}` : l'espace et le tiret évitent `${{{`, que Jinja lit mal. -#}
# La configuration de l'instance, montée en lecture seule sur /config (M-0006, § 5) : le dossier
# config/ de l'instantané du commit de données, jamais le clone des données. `dc` (lib.sh) n'ajoute
# ce fichier que quand compose.env porte {{ prefixe }}CONFIG, que le déploiement n'écrit jamais en
# staging. Géré par le modèle.
services:
  app:
    volumes:
      - "${ {{- prefixe }}CONFIG:?}:/config:ro"
