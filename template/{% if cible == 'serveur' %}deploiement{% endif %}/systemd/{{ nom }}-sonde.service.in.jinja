# Rendu de deploiement/systemd/{{ nom }}-sonde.service.in par deploiement/installer-unites.sh.
# Ne pas modifier à la main : la sonde de prod alerte au moindre écart avec ce rendu.
[Unit]
Description={{ nom }} : sonde et déploiement (@ENV@)
OnFailure={{ nom }}-alerte@%n.service

[Service]
Type=oneshot
ExecStart=/bin/bash @CLONE@/deploiement/sonder.sh @ENV@
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=15min
