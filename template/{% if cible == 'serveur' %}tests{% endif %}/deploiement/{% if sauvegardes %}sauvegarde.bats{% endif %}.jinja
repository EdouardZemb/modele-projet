  DOUBLE_DOCKER_SAUVEGARDE_SORTIE="$sortie" sauvegarder prod
  [ "$status" -eq 0 ]
  [[ "$output" == *"i-secret-42"* ]]
  # deux échecs et un succès signalés, dont aucun ne contient la sortie
  [ "$(envois_echec "$HC_SAUVEGARDE" | wc -l)" -eq 2 ]
  [ "$(envois_ok "$HC_SAUVEGARDE" | wc -l)" -eq 1 ]
