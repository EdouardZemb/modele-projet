  local pid=$!
  attendre_appel docker
  # en plein instantané, les données sont lues : le verrou de la sonde et du déploiement est pris
  run ! flock -n "$ETAT/verrou" true
  kill -TERM -- "-$pid"
  wait "$pid" || true
  # une fois finie, il est libre
  flock -n "$ETAT/verrou" true
}

