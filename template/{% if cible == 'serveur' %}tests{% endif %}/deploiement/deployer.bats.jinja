  [ "$(signaux)" = "$(signal 'déployé 0.2.0') $HC" ]
}

@test "deployer_refuse_des_arguments_invalides" {
  local -a cas=(
    "prod"
    "prod $NOUVELLE"
    "prod $NOUVELLE 0.2.0 en-trop"
    "essai $NOUVELLE 0.2.0"
    "prod ghcr.io/edouardzemb/{{ nom }}:main main"
    "prod ghcr.io/edouardzemb/{{ nom }}@sha256:1234 main"
    "prod $NOUVELLE v0.2.0"
    "prod $NOUVELLE 0.2"
    "prod --retour en-trop"
    "prod --retourner"
    "--retour prod"
    "essai --retour"
  )
  local arguments
  for arguments in "${cas[@]}"; do
    # shellcheck disable=SC2086  # découpage voulu
    deployer $arguments
    [ "$status" -eq 64 ]
  done
  # une version sur deux lignes injecterait une variable dans compose.env
  deployer prod "$NOUVELLE" $'0.2.0\n{{ prefixe }}PORT=80'
  [ "$status" -eq 64 ]
  [ ! -s "$APPELS" ]
  [ ! -e "$ETAT/compose.env" ]
}
