{#- Gabarit Copier. `${ {{- prefixe }}X}` : l'espace et le tiret évitent `${{{`, que Jinja lit mal. -#}
#!/usr/bin/env bats
# lib.sh : charger_env, dc, projet.env, signaler, journal, santé, verrou, état déployé. (charger_secrets : voir secrets.bats.)

# Chaque test tourne dans son propre processus : les `export` d'un test ne fuient pas dans les autres
# (SC2030, SC2031). Le code de avec_lib est entre apostrophes pour se développer dans le sous-shell
# qui l'exécute, pas ici (SC2016).
{%- if not sauvegardes %}
# Sans sauvegardes, {{ prefixe }}SAUVEGARDES n'est jamais posée : les tests l'impriment avec la
# valeur « absente » par défaut.
{%- endif %}
# shellcheck disable=SC2016,SC2030,SC2031

bats_require_minimum_version 1.5.0

load aide

setup() {
  preparer_environnement
}

teardown() {
  abandonner_le_verrou
}

# Le contrat de lib.sh est son en-tête : une fonction publique (sans « _ » devant) qui n'y figure
# pas est une fonction que personne ne sait exister.
@test "l_en_tete_de_lib_liste_toutes_les_fonctions_publiques" {
  local fonction absentes="" en_tete
  en_tete="$(sed -n '1,/^{{ prefixe }}CLONE=/p' "$CLONE/deploiement/lib.sh")"
  while read -r fonction; do
    grep -qE "^#   $fonction( |\$)" <<<"$en_tete" || absentes="$absentes $fonction"
  done < <(grep -oE '^[a-z][a-z_]*\(\)' "$CLONE/deploiement/lib.sh" | tr -d '()')
  [ -z "$absentes" ] || {
    echo "fonctions publiques absentes de l'en-tête :$absentes" >&2
    return 1
  }
}

@test "charger_env_exporte_les_chemins_de_prod" {
  avec_lib 'charger_env prod
    printf "%s\n" "${{ prefixe }}CLONE" "${{ prefixe }}ETAT" "${{ prefixe }}DONNEES" "${ {{- prefixe }}SAUVEGARDES-absente}" \
      "$DOCKER_CONFIG" "${{ prefixe }}PROJET" "${{ prefixe }}PORT" "${{ prefixe }}URL_PUBLIQUE"
    # exportées, pour docker compose et les scripts enfants
    for v in {{ prefixe }}CLONE {{ prefixe }}ETAT {{ prefixe }}DONNEES{% if sauvegardes %} {{ prefixe }}SAUVEGARDES{% endif %} DOCKER_CONFIG \
        {{ prefixe }}PROJET {{ prefixe }}PORT; do
      [ -n "$(printenv "$v")" ] || { echo "$v non exportée"; exit 1; }
    done'
  [ "$status" -eq 0 ]
  [ "${lines[0]}" = "$CLONE" ]
  [ "${lines[1]}" = "${{ prefixe }}RACINE_ETAT/prod" ]
  [ "${lines[2]}" = "${{ prefixe }}RACINE_DONNEES/prod/donnees" ]
{%- if sauvegardes %}
  [ "${lines[3]}" = "${{ prefixe }}RACINE_SAUVEGARDES" ]
{%- else %}
  [ "${lines[3]}" = absente ]
{%- endif %}
  [ "${lines[4]}" = "${{ prefixe }}DOCKER_CONFIG" ]
  [ "${lines[5]}" = "{{ nom }}" ]
  [ "${lines[6]}" = "{{ bloc_ports }}" ]
  [ "${lines[7]}" = "https://{{ sous_domaine }}.{{ domaine }}" ]
}

