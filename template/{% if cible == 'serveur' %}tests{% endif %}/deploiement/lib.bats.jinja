  [ "$(appels_de docker | tail -n 1)" = "docker compose -p {{ nom }}-staging -f $CLONE/deploiement/compose.yml -f $CLONE/deploiement/compose.projet.yml --env-file ${{ prefixe }}RACINE_ETAT/staging/compose.env ps -q app" ]
