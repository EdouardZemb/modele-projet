# Deux fichiers compose : celui du modèle, puis les ajouts du projet, que compose fusionne.
@test "dc_passe_projet_fichier_compose_et_fichier_d_environnement" {
  creer_double docker
  avec_lib 'charger_env prod; dc ps -q app'
  [ "$status" -eq 0 ]
