@test "charger_env_valeurs_par_defaut_du_serveur" {
  unset {{ prefixe }}RACINE_ETAT {{ prefixe }}RACINE_DONNEES {{ prefixe }}RACINE_SAUVEGARDES {{ prefixe }}DOCKER_CONFIG
  avec_lib 'charger_env prod
    printf "%s\n" "${{ prefixe }}ETAT" "${{ prefixe }}DONNEES" "${ {{- prefixe }}SAUVEGARDES-absente}" "$DOCKER_CONFIG"
