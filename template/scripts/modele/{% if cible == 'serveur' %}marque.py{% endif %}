# La rampe : (luminance, (R, V, B)) à 0, 128 et 255.
RAMPE = ((0, (0x5C, 0x1A, 0x00)), (128, (0xE8, 0x59, 0x0C)), (255, (0xFF, 0xE3, 0xC2)))
ORANGE = (0xE8, 0x59, 0x0C)

